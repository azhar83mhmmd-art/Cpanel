# =============================
# Kairoo Store — Vercel + Supabase
# =============================
NODE_ENV=production
SESSION_SECRET=buat_string_acak_panjang_min_32_karakter
PANEL_SECRET=buat_secret_acak_untuk_enkripsi_password_panel

# Supabase (JANGAN taruh service role key di frontend)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Pterodactyl — cukup 3 variabel ini
PTERODACTYL_URL=https://panel.domainanda.com
PTERODACTYL_PTLA=ptla_xxxxxxxxxxxxxxxxx
PTERODACTYL_PTLC=ptlc_xxxxxxxxxxxxxxxxx

# Rate limit
MAX_CREATE_PER_MINUTE=5
MAX_LOGIN_PER_MINUTE=10

# First-deploy admin setup. Keep this secret; minimum 16 characters.
SETUP_ADMIN_SECRET=ganti_dengan_secret_setup_acak_minimal_16_karakter

# Optional: legacy local seed (not required for Vercel setup)
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=ChangeMe123!
